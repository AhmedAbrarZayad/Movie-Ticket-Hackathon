# Copy this file to `.env` before running Docker Compose.
API_PORT=3000
IMAGE_TAG=local

POSTGRES_DB=cinemaseat
POSTGRES_USER=cinemaseat
POSTGRES_PASSWORD=change-me

# Use this URL when running the backend directly on the host. Docker Compose
# supplies its own DATABASE_URL using the internal `postgres` service hostname.
DATABASE_URL=postgresql://cinemaseat:change-me@localhost:5432/cinemaseat
REDIS_URL=redis://localhost:6379
